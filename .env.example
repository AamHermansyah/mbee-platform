# Salin ke .env.local (lokal) atau isi di Vercel → Settings → Environment Variables.

# Database Supabase (Postgres). Hanya dipakai di server (app/api/*). Tabel dibuat otomatis di schema "mbee"
# saat request pertama, lalu diisi data contoh sekali. Lokal: pooler port 5432. Vercel: pakai port 6543 (transaction pooler).
DATABASE_URL=

# Voice AI (Gemini Live). Key dari Google AI Studio; hanya dipakai di server (/api/voice/session).
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE=Puck
# Model teks untuk menentukan status tiket dari balasan admin (cadangan otomatis: gemini-3.5-flash, gemini-2.5-flash)
GEMINI_TEXT_MODEL=gemini-3.8-flash

# Email kredensial akun setelah pembayaran di landing (SMTP). 465 = SSL, 587 = STARTTLS.
# Kosongkan EMAIL_USERNAME/EMAIL_PASSWORD atau isi EMAIL_DRY_RUN=1 → email tidak dikirim, hanya dicatat di log.
EMAIL_USERNAME=
EMAIL_PASSWORD=
SMTP_HOST=
SMTP_PORT=465
EMAIL_FROM=
EMAIL_FROM_NAME=Tim Onboarding Mbee Platform
EMAIL_DRY_RUN=0
